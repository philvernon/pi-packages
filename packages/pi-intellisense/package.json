{
  "name": "pi-intellisense",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philvernon/pi-packages.git",
    "directory": "packages/pi-intellisense"
  },
  "description": "Source-aware IntelliSense in the Pi transcript, with on-demand Neovim navigation",
  "keywords": [
    "pi-package"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node -e \"import('./src/index.ts').then(() => console.log('extension entry loads'))\"",
    "test:native": "node --test test/native/*.test.ts",
    "test:all": "npm test && npm run test:native",
    "test:integration": "node --test test/integration/*.test.ts"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "^8.12.2"
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3"
  }
}
